podTemplate(containers: [
    containerTemplate(name: 'helm', image: 'alpine/helm:3.1.1', command: 'sleep', args: '99d')
  ]) {

    node(POD_LABEL) {
           checkout([
              $class: 'GitSCM',
              branches: [[name: '*/main']],
              doGenerateSubmoduleConfigurations: false,
              extensions: [[$class: 'CleanCheckout']],
              submoduleCfg: [],
              userRemoteConfigs: [[credentialsId: 'github_newbenji', url: 'https://github.com/newbenji/charts.git']]
             ])

        stage('Test helm') {
            container('helm') {
                stage('helm version') {
                    sh '''
                    apk add git
                    # helm version
                    helm plugin install https://github.com/chartmuseum/helm-push
                    # ls -al
                    # pwd
                    helm lint newbenji.dk
                    helm package newbenji.dk
                    helm repo add chartmuseum https://chartmuseum.newbenji.dk
                    # helm repo update
                    # helm repo list
                    # helm search repo --versions
                    helm cm-push --force newbenji.dk/ chartmuseum
                    # ls -al
                    '''
                }
            }
        }

    }
}
